{
  "expo": {
    "name": "Маяк",
    "slug": "mayak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo01.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo01.png",
      "resizeMode": "contain",
      "backgroundColor": "#9452FE"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo01.png",
        "backgroundColor": "#9452FE"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.alinool.frontend",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },

    "web": {
      "favicon": "./assets/logo01.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "6618a287-44f9-4f04-b651-a2f1f434e569"
      }
    }
  }
}
